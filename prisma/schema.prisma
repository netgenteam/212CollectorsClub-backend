// 212CollectorsClub backend — Prisma schema
// Story 1.4: introduces the Catalog domain — the first models this schema
// needs ("create tables only when needed"). Franchise/ProductType/Rarity are
// native Postgres enums defined once here and imported everywhere, never
// per-module string constants (AD-2). Category is an admin-managed
// many-to-one grouping table on Product, independent of those enums (AD-2).
// Migrations are applied exclusively via `prisma migrate dev|deploy` (AD-1)
// — never manual DDL.

generator client {
  provider = "prisma-client"
  // Generated inside src/ (not a project-root sibling) so it stays under
  // tsconfig.build.json's rootDir ("./src") and `nest build` can emit it.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The TCG universe a Product belongs to (PRD §3 Glossary — e.g. "Pokémon",
/// "One Piece"). Native Postgres enum so catalog and admin-catalog can never
/// drift on valid values (AD-2).
enum Franchise {
  POKEMON
  ONE_PIECE
  MAGIC_THE_GATHERING
  YU_GI_OH
  DRAGON_BALL_SUPER
}

/// The physical/commercial form of a Product (PRD §3 Glossary — e.g.
/// "Booster", "Box", single card).
enum ProductType {
  SINGLE_CARD
  BOOSTER_PACK
  BOOSTER_BOX
  STARTER_DECK
  COLLECTOR_TIN
}

/// A Product's collectible rarity tier (PRD §3 Glossary — e.g. Common, Rare,
/// Ultra Rare).
enum Rarity {
  COMMON
  UNCOMMON
  RARE
  ULTRA_RARE
  SECRET_RARE
  PROMO
}

/// Admin-managed grouping table used for catalog browsing/filtering (FR-5).
/// Independent of Franchise/ProductType/Rarity — a separate taxonomy, per
/// AD-2. Backed by the `Categories` table (PRD §3 Glossary, HBA-001).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("Categories")
}

/// A sellable catalog item — a single card, a booster pack, a box, etc.
/// (PRD §3 Glossary). Backed by the `Products` table.
model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  description String
  franchise   Franchise
  productType ProductType
  rarity      Rarity
  priceUsd    Decimal     @db.Decimal(10, 2)
  stock       Int
  /// Placeholder for Epic 4 (AD-6 stock holds), added now so that story only
  /// needs to add the `StockHold` table later, not alter Product again
  /// mid-checkout-epic. Effective available stock = stock - heldQty.
  heldQty     Int         @default(0)

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  images ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Products")
}

/// One or more images associated with a Product (PRD §3 Glossary), one-to-
/// many from Product. Backed by the `Product_Images` table.
model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@map("Product_Images")
}
