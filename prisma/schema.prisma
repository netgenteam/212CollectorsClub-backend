// 212CollectorsClub backend — Prisma schema
// Story 1.4: introduces the Catalog domain — the first models this schema
// needs ("create tables only when needed"). Franchise/ProductType/Rarity are
// native Postgres enums defined once here and imported everywhere, never
// per-module string constants (AD-2). Category is an admin-managed
// many-to-one grouping table on Product, independent of those enums (AD-2).
// Migrations are applied exclusively via `prisma migrate dev|deploy` (AD-1)
// — never manual DDL.

generator client {
  provider        = "prisma-client"
  // Generated inside src/ (not a project-root sibling) so it stays under
  // tsconfig.build.json's rootDir ("./src") and `nest build` can emit it.
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

/// The TCG universe a Product belongs to (PRD §3 Glossary — e.g. "Pokémon",
/// "One Piece"). Native Postgres enum so catalog and admin-catalog can never
/// drift on valid values (AD-2).
enum Franchise {
  POKEMON
  ONE_PIECE
  MAGIC_THE_GATHERING
  YU_GI_OH
  DRAGON_BALL_SUPER
  TOPPS
  NARUTO
  /// Story 13.5 (FR-50, AD-33): franchise without its own enum value; the real
  /// franchise lives in the product's category tags. Clients must tolerate it.
  OTHER
}

/// The physical/commercial form of a Product (PRD §3 Glossary — e.g.
/// "Booster", "Box", single card).
enum ProductType {
  SINGLE_CARD
  BOOSTER_PACK
  BOOSTER_BOX
  STARTER_DECK
  COLLECTOR_TIN
  ACCESSORY
}

/// Story 13.4 (FR-49, AD-33): edition language of a Product.
enum ProductLanguage {
  ES
  EN
  JP
  CN
  OTHER
}

/// A Product's collectible rarity tier (PRD §3 Glossary — e.g. Common, Rare,
/// Ultra Rare).
enum Rarity {
  COMMON
  UNCOMMON
  RARE
  ULTRA_RARE
  SECRET_RARE
  PROMO
}

/// Admin-managed grouping table used for catalog browsing/filtering (FR-5).
/// Independent of Franchise/ProductType/Rarity — a separate taxonomy, per
/// AD-2. Backed by the `Categories` table (PRD §3 Glossary, HBA-001).
enum CategoryType {
  ROOT
  SUBCATEGORY
}

enum CategoryDimension {
  FRANCHISE
  SEALED_FORMAT
  EDITION_LANGUAGE
  SET_COLLECTION
  CUSTOM
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Story 13.2 (AD-33): taxonomy. ROOT rows carry no dimension/parent (SQL CHECK).
  type      CategoryType       @default(ROOT)
  dimension CategoryDimension?
  parentId  String?            @db.Uuid
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)

  /// Self-relation; ON DELETE RESTRICT so the DB is the guard of 409 CATEGORY_HAS_CHILDREN.
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products    Product[]
  /// Story 13.5 (AD-33): products tagged with this category (n:m).
  productTags ProductCategory[]

  @@index([parentId])
  @@index([dimension, isActive])
  @@map("Categories")
}

/// A sellable catalog item — a single card, a booster pack, a box, etc.
/// (PRD §3 Glossary). Backed by the `Products` table.
model Product {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  slug            String          @unique
  description     String
  franchise       Franchise
  productType     ProductType
  rarity          Rarity
  /// Story 13.4 (FR-49, AD-33): edition language; existing rows default to EN.
  editionLanguage ProductLanguage @default(EN)
  priceUsd        Decimal         @db.Decimal(10, 2)
  stock           Int
  /// Placeholder for Epic 4 (AD-6 stock holds), added now so that story only
  /// needs to add the `StockHold` table later, not alter Product again
  /// mid-checkout-epic. Effective available stock = stock - heldQty.
  heldQty         Int             @default(0)
  /// Story 8.2 (FR-22): closes the gap Stories 2.1/2.3 flagged ("deactivated
  /// Product" had no real field yet). Defaults `true` so every Story 1.4
  /// seed row stays publicly visible after this migration with no data
  /// backfill needed. `CatalogService`'s public reads (`listProducts`,
  /// `getProductDetail`) filter on this; `AdminProductsService`'s admin
  /// reads never do (Admin must always see deactivated Products too).
  /// **Deactivate, never a DB-level soft-delete flag pair** — this is the
  /// ONLY mechanism `AdminProductsService.remove` falls back to when a real
  /// `DELETE` is rejected by Postgres because the Product still has
  /// historical `OrderLine`/`CartItem`/`StockHold` rows referencing it (see
  /// that service's own doc comment for the full delete-vs-deactivate
  /// policy writeup).
  isActive        Boolean         @default(true)
  /// Story 11.1 (FR-35, AD-18): preorder flag; `releaseDate` is informational only.
  isPreorder      Boolean         @default(false)
  releaseDate     DateTime?       @db.Timestamptz
  /// Story 11.1 (AD-18): PSA|BGS|CGC|RAW, validated at DTO level (varchar, not a
  /// Prisma enum, so new grading houses need no `ALTER TYPE`).
  gradingCompany  String?         @db.VarChar(10)
  gradeValue      String?         @db.VarChar(20)
  certNumber      String?         @db.VarChar(50)

  categoryId   String            @db.Uuid
  category     Category          @relation(fields: [categoryId], references: [id])
  /// Story 13.5 (AD-33): taxonomy tags; `categoryId` stays the single main category.
  taxonomyTags ProductCategory[]

  images           ProductImage[]
  /// Story 11.4 (FR-34, AD-18): stored external market reference links.
  marketReferences ProductMarketReference[]
  /// Story 15.3 (FR-65, AD-53): optional link to the external master card;
  /// SET NULL when the master card is deleted. Existing rows: manual, unlinked.
  masterCardId     String?                  @db.Uuid
  masterCard       MasterCard?              @relation(fields: [masterCardId], references: [id], onDelete: SetNull)
  isManual         Boolean                  @default(true)
  autoSyncPrice    Boolean                  @default(false)
  lastMarketSyncAt DateTime?                @db.Timestamptz
  /// Story 3.1: every CartItem row referencing this Product, across every
  /// guest Cart. Read-only back-reference — CartService never traverses it,
  /// but Prisma requires the relation declared on both sides.
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  /// Story 6.1: every ContactInquiry that optionally referenced this
  /// Product. Read-only back-reference, same reasoning as `cartItems`
  /// above.
  contactInquiries ContactInquiry[]
  /// Story 4.1: every OrderLine snapshot that referenced this Product at
  /// purchase time. Read-only back-reference — OrderLine itself carries its
  /// own name/price snapshot and never re-reads this relation for display,
  /// same "never a live reference" reasoning documented on OrderLine below.
  orderLines       OrderLine[]
  /// Story 4.1 (AD-6): every StockHold ever created against this Product's
  /// `heldQty`. Read-only back-reference — StockHoldService (Story 5.2)
  /// queries StockHold directly by `expiresAt`, never through this list.
  stockHolds       StockHold[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Story 2.2 / AD-10: pg_trgm GIN indexes backing the FR-6 free-text
  /// `search=` filter, so ILIKE/similarity matching on name and description
  /// stays within the NFR-1 300ms p95 budget instead of a full table scan.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([editionLanguage])
  @@index([masterCardId])
  @@map("Products")
}

/// Story 15.3 (FR-65, AD-53): local catalog of external master cards (tcgapi.dev).
/// NOT a Product: never listed by /products, facets or counts. Fake-client rows
/// use externalProvider 'FAKE' so they never collide with 'TCGAPI_DEV'.
model MasterCard {
  id               String          @id @default(uuid()) @db.Uuid
  externalProvider String
  externalId       String
  name             String
  cleanName        String
  /// lowercase, NFKD, no accents: cleanName + setName + cardNumber.
  searchText       String
  franchise        Franchise
  gameSlug         String
  setId            String
  setName          String
  cardNumber       String?
  /// Raw API rarity (mapped on demand by mapRarity).
  rarity           String?
  editionLanguage  ProductLanguage @default(EN)
  printing         String?
  tcgplayerId      Int?
  imageSmall       String?
  imageLarge       String?
  marketPriceUsd   Decimal?        @db.Decimal(10, 2)
  lowPriceUsd      Decimal?        @db.Decimal(10, 2)
  /// Replaces the PRD's highPriceUsd: the API has no high price.
  medianPriceUsd   Decimal?        @db.Decimal(10, 2)
  priceAsOf        DateTime?       @db.Date
  rawApiData       Json
  lastSyncedAt     DateTime        @default(now()) @db.Timestamptz
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  products         Product[]

  @@unique([externalProvider, externalId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([franchise, setId])
  @@index([setId])
  @@map("Master_Cards")
}

/// Story 11.4 (FR-34, AD-18/AD-23): external market-price providers a
/// Product can link to. Native Postgres enum.
enum MarketProvider {
  CARDMARKET
  PRICECHARTING
  PSA_CERT
  TCGPLAYER
}

/// Story 11.4 (FR-34, AD-18): admin-curated external reference link for a
/// Product. The PSA cert link is calculated at read time (AD-21), never
/// required to be stored here. Cascades on Product delete.
model ProductMarketReference {
  id                String         @id @default(uuid()) @db.Uuid
  productId         String         @db.Uuid
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider          MarketProvider
  label             String
  url               String
  suggestedPriceEur Decimal?       @db.Decimal(10, 2)
  sortOrder         Int            @default(0)

  @@unique([productId, provider, url])
  @@map("Product_Market_References")
}

/// A guest buyer's shopping cart (Story 3.1, first story needing this
/// model). Identity is deliberately opaque: nothing but this row's `id`
/// (a UUID) is ever handed to the client, carried in a signed HttpOnly
/// cookie (AD-5) — never a JWT, never buyer PII on this path.
/// `expiresAt` implements AD-5's 30-day *sliding* expiry: `CartService`
/// pushes it forward by 30 days from "now" every time `POST cart/items`
/// touches this cart, so an actively-used guest cart never expires
/// mid-session while an abandoned one eventually does. Nothing currently
/// deletes expired rows (no cron in this story's scope, unlike AD-6's
/// stock-hold expiry cron) — an expired Cart is simply treated as if it
/// didn't exist by CartService; a future maintenance job may reap them.
model Cart {
  id         String    @id @default(uuid()) @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime
  /// Story 12.5 (AD-29): owner account; null = anonymous (cookie) cart.
  customerId String?   @unique @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items CartItem[]

  @@map("Carts")
}

/// One Product line within a Cart (Story 3.1). `@@unique([cartId,
/// productId])` enforces "at most one row per Product per Cart" — Story
/// 3.1's decision is that adding a Product already present in the Cart
/// increments `quantity` on this same row rather than inserting a second
/// row for the same Product (see CartService.addItem for the reasoning).
model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @db.Uuid
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("Cart_Items")
}

/// A submitted Contact Inquiry (Story 6.1, FR-18/FR-19). `productId` is
/// optional (SetNull on Product delete, not Cascade — the inquiry itself is
/// never lost just because the Product it referenced was later removed from
/// the catalog; AD-2 already treats "referenced elsewhere" as a reason not
/// to hard-delete, and this mirrors that same caution here). `emailStatus`
/// records whether the best-effort admin-notification email succeeded, per
/// the Contact correctness rule (ARCHITECTURE-SPINE.md "Consistency
/// Conventions" + architecture.md FR-18 note): the row is written first,
/// unconditionally once validation passes, and this field is only updated
/// *after* that write attempts to reflect what happened to the email —
/// never the other way around, and a failure here never rolls back or
/// deletes the row above it.
enum ContactInquiryEmailStatus {
  PENDING
  SENT
  FAILED
}

model ContactInquiry {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  email   String
  message String

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Best-effort outcome of the admin-notification email attempted after
  /// this row was persisted. Starts PENDING at creation (before the send is
  /// even attempted), never blocks or gates the row's own persistence.
  emailStatus       ContactInquiryEmailStatus @default(PENDING)
  /// Set only when emailStatus ends up FAILED — the caught error's message,
  /// for operator triage, never re-thrown to the caller.
  emailErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Contact_Inquiries")
}

/// One or more images associated with a Product (PRD §3 Glossary), one-to-
/// many from Product. Backed by the `Product_Images` table.
model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@map("Product_Images")
}

// ---------------------------------------------------------------------------
// Story 4.1 — Checkout, Orders, Stock Holds, admin-maintained FX rate.
// ---------------------------------------------------------------------------

/// **Known design gap, resolved pragmatically for this story (see the
/// Story 4.1 Dev report for the full writeup).** AD-4 requires "a single
/// storewide exchange-rate value the Admin edits", but no Sprint 3 story in
/// the backlog (7.1/7.2 = admin auth, 8.x = catalog CRUD, 9.x = order/
/// payment management) actually owns "Admin edits the FX rate" — it's a
/// gap between the PRD and the epics list, not something this story can
/// leave unresolved (checkout cannot snapshot a VES total without reading
/// a rate from *somewhere*). This table is the simplest mechanism that
/// satisfies AD-4 today: a single mutable row, its `id` always the fixed
/// literal `SINGLETON_FX_RATE_ID` (see `src/checkout/fx-rate.constants.ts`),
/// seeded once by `prisma/seed.ts` alongside the catalog. There is
/// deliberately **no** admin endpoint to edit this row yet — that is
/// explicitly out of scope for Story 4.1 per the Dev brief. A future story
/// (not yet in the Sprint 3 backlog — flag this for PM/Architect) should
/// add a `PATCH` admin route that updates this same row's `vesPerUsd`; no
/// schema change is expected when that lands, since this table already
/// models "the current rate" as a single row, the same shape AD-4 itself
/// describes.
model FxRateSetting {
  id        String   @id @db.VarChar(32)
  /// VES per 1 USD, e.g. 40.5000 means 1 USD = 40.50 VES. AD-3's
  /// `Decimal(18,4)` precision, snapshotted verbatim onto
  /// `Order.fxRateVesPerUsd` at checkout time — never recomputed after.
  vesPerUsd Decimal  @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  @@map("Fx_Rate_Settings")
}

/// The payment method a checkout was submitted with (`PAGO_MOVIL` or
/// `STRIPE`; the old third-party rail was retired in Story 14.6, AD-49).
enum PaymentRail {
  PAGO_MOVIL
  STRIPE
}

/// AD-8 `[ASSUMPTION — pending Nabil confirmation, PRD OQ6]`. Both
/// delivery-only and pickup-only future business answers fit this schema
/// unchanged — only the frontend's exposed UI paths would need to change.
enum FulfillmentType {
  DELIVERY
  PICKUP
}

/// AD-7's 8-state Order lifecycle. Story 4.1 only ever writes
/// `PENDING_VERIFICATION` directly (Pago Móvil never passes through
/// `PAYMENT_PROCESSING` — that transient state is Stripe-only). The full enum is modeled now (not grown incrementally per
/// story) since this schema is the shared source of truth every future
/// order-transition story (5.2, 9.2, 9.3) reads from — see AD-7 for the
/// full legal-transition table.
enum OrderStatus {
  PAYMENT_PROCESSING
  PENDING_VERIFICATION
  PAID
  PAYMENT_FAILED
  PAYMENT_REJECTED
  EXPIRED
  FULFILLED
  CANCELLED
}

/// AD-7's typed actor on every OrderStatusHistory row. `ADMIN` rows carry a
/// real `adminUserId` FK to `AdminUser` (added by Story 7.1, which
/// introduced that model — see `OrderStatusHistory.adminUserId` below).
enum OrderActorType {
  SYSTEM
  STRIPE_WEBHOOK
  ADMIN
  CRON
}

/// A buyer's order (PRD §3 Glossary). AD-3/AD-4: `totalUsd` is always set;
/// `fxRateVesPerUsd`/`totalVes` are set once at creation for Pago Móvil
/// orders only (both stay null for Stripe orders, which never touch VES)
/// and are never recomputed afterward — the buyer's payment instructions
/// and the admin's reconciliation view must always agree on the same VES
/// figure for the life of the order. AD-8: `recipientName`/`recipientPhone`
/// are always required; the address fields are populated only when
/// `fulfillmentType = DELIVERY` (enforced by CheckoutDto's conditional
/// validation, not by a DB constraint — Postgres has no easy portable way
/// to express "these columns are NOT NULL only when this other column has
/// this value", and a rejected-at-the-door DTO is the simpler, equally
/// correct place to enforce it). AD-17: `accessTokenHash` stores only the
/// SHA-256 hash of the one-time `orderAccessToken` handed to the buyer in
/// the checkout response — the raw token itself is never persisted
/// anywhere (see CheckoutService for the hashing rationale).
model Order {
  id     String      @id @default(uuid()) @db.Uuid
  status OrderStatus

  paymentRail     PaymentRail
  fulfillmentType FulfillmentType
  recipientName   String
  recipientPhone  String
  /// Populated only when fulfillmentType = DELIVERY; null for PICKUP.
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  /// AD-8: constrained to Venezuela for MVP — CheckoutService sets this to
  /// the literal "Venezuela" server-side for DELIVERY orders rather than
  /// accepting it as buyer input, since there is currently only one valid
  /// value (see CheckoutDto's doc comment for the full reasoning).
  country         String?

  totalUsd        Decimal  @db.Decimal(10, 2)
  /// Null for Stripe orders (AD-3) — only ever set, once, for Pago Móvil.
  fxRateVesPerUsd Decimal? @db.Decimal(18, 4)
  totalVes        Decimal? @db.Decimal(14, 2)

  /// AD-17: SHA-256 hash of the one-time orderAccessToken. The raw token
  /// is returned to the buyer exactly once, in the checkout response, and
  /// never stored.
  accessTokenHash String

  /// Story 14.3 (AD-44): Stripe Checkout Session id (`cs_...`), the
  /// correlation key for the webhook. Null for other rails and briefly null
  /// for Stripe between Order creation and the Stripe call.
  stripeCheckoutSessionId String? @unique

  /// Story 14.3 (AD-44): `pi_...`, only known on completion; not unique and
  /// not used for lookup.
  stripePaymentIntentId String?

  /// Story 12.6 (AD-31): owner account; null = guest order. SetNull keeps
  /// the order (and its access-token flows) if the account is ever deleted.
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines           OrderLine[]
  statusHistory   OrderStatusHistory[]
  stockHolds      StockHold[]
  /// Story 4.2: every ProofOfPayment file the buyer has uploaded against
  /// this Order. A one-to-many relation (not a single nullable column) per
  /// AD-12 — modeled as its own entity so a re-upload (e.g. the buyer's
  /// first screenshot was illegible) never has to overwrite/destroy the
  /// previous row, and Story 9.2's admin review can see the full history.
  /// "Does this Order have proof attached yet" (AC3) is simply "is this
  /// list non-empty" — see ProofOfPaymentService.
  proofOfPayments ProofOfPayment[]

  @@index([customerId, createdAt])
  @@index([stripePaymentIntentId])
  @@map("Orders")
}

/// One Product line within an Order — a **snapshot**, never a live
/// reference. `productName`/`unitPriceUsd` are copied from Product at the
/// moment of purchase and never re-read from it afterward, so a later
/// rename or price change on the Product can never retroactively alter a
/// historical Order's line items (AD-3's snapshot principle, applied to
/// line items the same way it's applied to the order-level FX rate).
/// `productId` itself is kept (not nulled/removed) purely as a traceability
/// reference for admin tooling — display logic must never read
/// `product.name`/`product.priceUsd` through it.
model OrderLine {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  productName  String
  unitPriceUsd Decimal @db.Decimal(10, 2)
  quantity     Int
  lineTotalUsd Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@map("Order_Lines")
}

/// AD-7/AD-16: an immutable audit trail row for every Order status
/// transition, including the very first `[]->pending_verification`/
/// `[]->payment_processing` write at Order creation (`fromStatus = null`
/// represents "no prior state" for that first row). Written by
/// `src/common/order-status-transition.ts` — see that module for the
/// guarded-update helper this story introduces for AD-16, reused by every
/// later order-transition story (4.3, 5.2, 9.2, 9.3).
model OrderStatusHistory {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Null only for the very first history row on a given Order (the
  /// `[]->X` creation transition) — every later row has a real prior
  /// status.
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorType   OrderActorType
  /// Set only when actorType = ADMIN. Story 7.1 adds the FK constraint to
  /// `AdminUser` anticipated by OrderActorType's doc comment above — every
  /// row written so far has `actorType` in {SYSTEM, STRIPE_WEBHOOK, CRON}
  /// with `adminUserId = null`, so this FK is safe to add without a data
  /// backfill. `onDelete: SetNull` (not Cascade, not Restrict): an
  /// AdminUser row is never expected to be deleted by anything in this
  /// codebase today, but if it ever is, the audit trail row itself must
  /// survive — only the actor reference is cleared, never the history.
  adminUserId String?        @db.Uuid
  adminUser   AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("Order_Status_History")
}

// ---------------------------------------------------------------------------
// Story 7.1 — Admin Auth (AD-11, AD-14).
// ---------------------------------------------------------------------------

/// A store Admin account (AD-11, FR-20/FR-21). Single flat role for the
/// MVP — see `roleTier` below. Seeded from environment variables only
/// (`prisma/seed.ts`), never hardcoded (FR-3); `POST /api/v1/admin/auth/login`
/// is the only way this table is ever read by the running app.
model AdminUser {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique
  email    String @unique

  /// Argon2id digest (OWASP-2026-preferred over bcrypt, per AD-11) of the
  /// Admin's password — produced by the `argon2` package
  /// (`argon2.hash(..., { type: argon2.argon2id })`), never a plaintext or
  /// reversibly-encrypted value. Deliberately absent from every DTO/response
  /// type in this codebase (`AdminUserResponseDto` etc.) — every read of
  /// this model that can reach an HTTP response uses an explicit Prisma
  /// `select` that omits this column entirely, so there is no field to
  /// accidentally forget to strip.
  ///
  /// DEPRECATED (Story 12.2, AD-26): the source of truth for the password is
  /// now `AdminAccount.password` (BetterAuth). This column is kept only as a
  /// rollback path and as the lazy-provisioning source at login for admins
  /// that still have no `AdminAccount` row; a later migration drops it.
  passwordHash String

  /// Story 12.2 (BetterAuth user fields). Admins have no email verification
  /// flow, hence the `true` default.
  emailVerified Boolean @default(true)
  image         String?

  /// Nullable, unused hook for a future staff-role split (PRD OQ10,
  /// AD-11) — no code anywhere reads this column yet, and this story adds
  /// no permission logic gated on it. Left as a free-form nullable string
  /// (not an enum) since OQ10 itself — what the tiers even are — is still
  /// unanswered by the client; committing to an enum now would risk a
  /// second migration once that answer arrives, which is exactly what this
  /// hook exists to avoid.
  roleTier String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Story 7.1: back-reference for the `OrderStatusHistory.adminUserId` FK
  /// above. Read-only from AdminUser's side — nothing in this story
  /// traverses it; Story 9.x (admin order actions) is the first real
  /// writer of an `actorType = ADMIN` history row.
  orderStatusHistoryRows OrderStatusHistory[]

  /// Story 10.1: back-reference for `LandingConfigEntry.updatedById`, same
  /// nullable-FK pattern as `orderStatusHistoryRows` above.
  landingConfigEntries LandingConfigEntry[]

  /// Story 12.2: BetterAuth session/account rows (AD-26). The all-lowercase
  /// names are mandatory: the BetterAuth Prisma adapter joins through
  /// `<lowercased modelName>s` (e.g. `adminaccounts`).
  adminsessions AdminSession[]
  adminaccounts AdminAccount[]

  @@map("Admin_Users")
}

/// Story 12.2 (AD-26/AD-27): BetterAuth session of the admin instance. The
/// row IS the revocable admin login: logout deletes it. `expiresAt` is
/// created+8h and never refreshed.
model AdminSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Admin_Sessions")
}

/// Story 12.2 (AD-26): BetterAuth credential account of an admin
/// (`providerId = 'credential'`, `password` = Argon2id digest).
model AdminAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("Admin_Accounts")
}

/// Story 7.2 (AD-11, FR-21): persisted denylist of revoked Admin JWTs,
/// checked by `AdminJwtStrategy.validate` on every Admin-gated request in
/// addition to `passport-jwt`'s own signature/expiry check. Deliberately a
/// plain Postgres table (not an in-memory Set/cache) — an in-memory
/// denylist would silently reset on every deploy restart (Story 1.3's
/// CI/CD pipeline), defeating FR-21's "logout invalidates" guarantee the
/// moment the app redeploys. `jti` is the JWT's own unique-per-token claim
/// (a random UUID minted once per `AdminAuthService.login` call — see
/// `AdminJwtPayload`) — using it as this table's primary key gives the
/// per-request revocation lookup a free unique index, no separate
/// `@@index` needed. `expiresAt` mirrors the JWT's own `exp` claim
/// (converted to a `DateTime`) purely so a future cleanup job could safely
/// prune rows past their natural expiry — not implemented by this story,
/// since a revoked-but-unpruned row is harmless (the JWT itself would
/// already be rejected as expired by then regardless of this table) and no
/// story requires the cleanup job yet.
///
/// DEPRECATED (Story 12.2): no longer read nor written; admin logout now
/// deletes the `AdminSession` row. Kept (rollback) until a later migration.
model RevokedToken {
  jti       String   @id @db.Uuid
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@map("Revoked_Tokens")
}

/// AD-6: a soft stock reservation created atomically alongside the guarded
/// `UPDATE "Products" SET "heldQty" = "heldQty" + qty WHERE stock -
/// "heldQty" >= qty` (see CheckoutService — zero affected rows aborts the
/// whole checkout transaction, so a StockHold row is only ever inserted
/// once that guard has already succeeded, never speculatively). `quantity`
/// mirrors the corresponding OrderLine's quantity for the same Product.
/// `releasedAt` stays null for the lifetime of an active hold; Story 5.2's
/// expiry cron (and Story 9.2's admin-confirm, which converts a hold into a
/// real stock decrement) are the only writers expected to ever set it —
/// out of scope for this story, which only creates rows here with
/// `releasedAt = null`.
model StockHold {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity   Int
  expiresAt  DateTime
  releasedAt DateTime?

  createdAt DateTime @default(now())

  @@map("Stock_Holds")
}

// ---------------------------------------------------------------------------
// Story 4.2 — Pago Móvil Proof-of-Payment Upload.
// ---------------------------------------------------------------------------

/// AD-12: Proof of Payment is modeled as its **own** entity (one-to-many
/// from Order), never a column on `Order` — a later re-upload, or Story
/// 9.2's admin review needing to see every attempt, would otherwise have
/// nowhere to go. `filePath` is a path **relative to `uploads/private/`**
/// on local disk (never a public URL — there isn't one; AD-12 forbids this
/// directory from ever being static-mounted) and is always a server-
/// generated name (a UUID plus an extension derived from the validated
/// MIME type), never the client's original filename — see
/// `ProofOfPaymentService` for why (path-traversal safety: the client's
/// filename never participates in constructing a disk path at all, so
/// there is nothing to sanitize).
model ProofOfPayment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Relative to `uploads/private/` (e.g.
  /// "proof-of-payment/3f9e...-c1a2.png") — join with the configured
  /// uploads root to get an absolute path. Never a client-supplied value.
  filePath  String
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())

  @@map("Proof_Of_Payments")
}

// ---------------------------------------------------------------------------
// Story 10.1 — Admin Edit & Public Read of Landing Texts and Banners
// (Epic 10, AD-9/AD-10). Introduces the ONE generic table the whole
// AdminLanding epic reuses.
// ---------------------------------------------------------------------------

/// AD-9: a single generic JSONB-backed config row, unique on
/// `(section, key)`. Story 10.1 only ever writes `section` = "texts" |
/// "banners", restricted to the fixed key set application code enforces
/// (`src/admin-landing/landing-content.constants.ts`) — but nothing about
/// this model itself is specific to those two sections. Stories 10.2 (Drop
/// 212 countdown, `section` = "drop212") and 10.3 (Pack-Opening Simulator,
/// `section` = "pack_simulator") are expected to add their own fixed key
/// sets in application code and reuse this exact table — **no new
/// migration expected for either**. `value` is always JSONB regardless of
/// `valueType`, so a future section can hold an arbitrary nested structure
/// (e.g. a per-rarity odds table) with no schema change.
///
/// Public read (`GET /api/v1/landing-content`, unauthenticated, Story
/// 10.1) groups every row by `section`. AD-10: no caching layer anywhere in
/// this app — a public read always queries this table directly, so an
/// admin's write is visible on the very next public read with ~0s
/// propagation delay, nothing to invalidate.
model LandingConfigEntry {
  id String @id @default(uuid()) @db.Uuid

  /// Top-level grouping the public GET groups its response by (e.g.
  /// "texts", "banners", future "drop212"/"pack_simulator"). A free-form
  /// string, not an enum, on purpose — each section's fixed, editable key
  /// set is enforced in application code, not at the DB level, precisely so
  /// 10.2/10.3 can introduce new sections without touching this migration.
  section String

  /// The field name within `section` (e.g. "heroTitle", "banner1"). Unique
  /// together with `section` below — this is the whole row's identity.
  key String

  /// Admin-UI rendering hint only ("text" | "json" as of this story) —
  /// never branched on by this backend's own validation logic; the fixed
  /// key set per section (application code) already pins each key's real
  /// expected shape. Free-form string (not an enum) for the same
  /// no-migration-for-10.2/10.3 reason as `section` above.
  valueType String

  /// Always JSONB regardless of `valueType`. A plain edited text (Story
  /// 10.1 "texts" section) is stored as a JSON string; a banner (Story
  /// 10.1 "banners" section) is stored as a JSON object
  /// (`{ imageUrl, title, linkUrl }`). A future section (10.2/10.3) can
  /// store any nested JSON shape its variables need with no schema change.
  value Json

  updatedAt DateTime @updatedAt

  /// Same nullable-FK-to-AdminUser pattern as
  /// `OrderStatusHistory.adminUserId` (Story 7.1): nullable because the
  /// initial placeholder rows this story's seed creates have no admin
  /// author, and `onDelete: SetNull` so a later AdminUser deletion can never
  /// cascade away or block-delete a LandingConfigEntry's value — the
  /// content itself always outlives whichever admin last touched it.
  updatedById String?    @db.Uuid
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([section, key])
  @@map("Landing_Config_Entries")
}

/// Anonymous wishlist (Story 11.5, FR-36, AD-22), identified by a signed
/// `wishlistId` cookie. `expiresAt` is a 30-day sliding window, filtered on read.
model Wishlist {
  id         String    @id @default(uuid()) @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime
  /// Story 12.5 (AD-29): owner account; null = anonymous (cookie) wishlist.
  customerId String?   @unique @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items WishlistItem[]

  @@map("Wishlists")
}

/// One saved Product. Product FK cascades so the admin hard-delete (Story 8.2) is never blocked.
model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @db.Uuid
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("Wishlist_Items")
}

/// Story 12.3 (AD-26, FR-42): storefront customer account, BetterAuth
/// `user` of the CUSTOMER instance. Separate tables from `AdminUser` on
/// purpose (FR-41): no shared table, no role column. Passwords live in
/// `CustomerAccount.password` (Argon2id), never here.
model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  /// Normalized (trim + lowercase) at the DTO and again by BetterAuth.
  email         String   @unique
  name          String
  phone         String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// The all-lowercase names are mandatory: the BetterAuth Prisma adapter
  /// joins through `<lowercased modelName>s`.
  customersessions CustomerSession[]
  customeraccounts CustomerAccount[]
  carts            Cart[]
  wishlists        Wishlist[]
  orders           Order[]

  @@map("Customers")
}

/// Story 12.3: BetterAuth session of the customer instance (cookie
/// `cc_session`, 7 days, 1-day sliding). The row IS the revocable login.
model CustomerSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Customer @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Customer_Sessions")
}

/// Story 12.3: credential account (`providerId = 'credential'`, `password`
/// = Argon2id digest) of a customer.
model CustomerAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user Customer @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("Customer_Accounts")
}

/// Story 12.3: BetterAuth verification tokens (email verification and
/// password reset are filled in by Story 12.4; the table exists from now).
model CustomerVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("Customer_Verifications")
}

/// Story 13.5 (FR-50, AD-33): n:m tag between Product and Category.
/// Deleting a Product cascades its links; deleting a tagged Category is RESTRICTed.
model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("Product_Categories")
}

/// Story 14.3 (AD-44): idempotency ledger for Stripe webhook deliveries.
/// No FK to Order on purpose (events for unknown orders are recorded too).
model StripeWebhookEvent {
  eventId     String   @id
  type        String
  orderId     String?  @db.Uuid
  /// paid | failed | noop | amount_mismatch | unknown_order
  outcome     String
  processedAt DateTime @default(now())

  @@map("Stripe_Webhook_Events")
}
