# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored — never commit real secrets.

# --- App ---
# Runtime environment: development | staging | production
NODE_ENV=development
# HTTP port the NestJS app listens on
PORT=3000
# Secret used to SIGN the HttpOnly `cartId` cookie (Story 3.1, AD-5) via
# cookie-parser + Express's native `res.cookie(..., { signed: true })`.
# A tampered/forged cartId cookie fails signature verification and is
# treated as if no cart cookie were sent at all — never trusted.
# Placeholder below is dev-only; use a long random value in staging/prod.
COOKIE_SECRET=dev-only-cart-cookie-secret-change-me

# --- Database (PostgreSQL via Prisma) ---
# Must match the docker-compose.yml service for local dev:
#   host: localhost, port: 5433 (mapped from container's 5432),
#   db: collectorsclub_dev, user: collectorsclub
# Password below is a placeholder — replace with a real value locally,
# and keep it in sync with POSTGRES_PASSWORD if you override that too.
DATABASE_URL="postgresql://collectorsclub:collectorsclub_dev_password@localhost:5433/collectorsclub_dev?schema=public"

# --- Docker Compose (local dev Postgres container only) ---
# Optional override for the docker-compose Postgres password.
# Defaults to a dev-only placeholder in docker-compose.yml if unset.
POSTGRES_PASSWORD=collectorsclub_dev_password

# --- Email / SMTP (Story 6.1, MailerService) ---
# NOTE: the real production SMTP provider is PRD Open Question OQ9 — still
# UNRESOLVED, pending confirmation from the client (Nabil) before launch.
# The values below are a LOCAL DEV placeholder only, pointed at a
# disposable MailHog/maildev container (see README/docs for how to run
# one). Swapping to the real provider later is an env-var-only change —
# never a code change — by design (see MailerService's doc comment).
# SMTP server host/port MailerService connects to.
SMTP_HOST=localhost
SMTP_PORT=1025
# "true" only for a provider that requires implicit TLS on connect
# (typically port 465). Leave "false" for MailHog/maildev and most
# STARTTLS-capable providers on 587.
SMTP_SECURE=false
# Optional — leave both blank for an unauthenticated local test server
# (MailHog/maildev). A real provider (OQ9) will require both.
SMTP_USER=
SMTP_PASS=
# The "From" header on outbound mail (contact-inquiry admin notification).
SMTP_FROM="212CollectorsClub <no-reply@212collectorsclub.test>"
# Where the "new contact inquiry" notification email is sent (Story 6.1,
# FR-18). Not necessarily the same address as SMTP_USER.
ADMIN_CONTACT_EMAIL=admin@212collectorsclub.test

# --- Stripe (Story 14.3, AD-45/AD-48) ---
# Leave STRIPE_SECRET_KEY blank for local dev/CI: the app falls back to an
# in-memory FakeStripeClient (no network; webhook signatures are still really
# verified against STRIPE_WEBHOOK_SECRET or a built-in fake secret).
# Setting it activates the real Stripe SDK client AND makes
# STRIPE_WEBHOOK_SECRET mandatory (the app refuses to boot without it).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) from the Stripe dashboard or `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# FRONTEND_URL (below, already documented) is also used for Stripe's
# success_url/cancel_url redirects.

# --- Admin auth (Story 7.1, AD-11) ---
# Story 12.2 (AD-26/AD-32): the Admin session token is a BetterAuth signed
# session token (8h, no sliding refresh). Preferred name: ADMIN_AUTH_SECRET;
# the pre-12.2 name ADMIN_JWT_SECRET is still accepted as a fallback (same
# value works) so old .env/CI keep booting. Set at least one of them.
# Secret used to SIGN and VERIFY the Admin session token.
# Deliberately a DIFFERENT secret than COOKIE_SECRET (unrelated trust
# boundaries: a forged cart cookie only affects an anonymous guest cart,
# a forged Admin JWT would grant Admin-Dashboard access — never share the
# value). Placeholder below is dev-only; use a long random value (e.g.
# `openssl rand -hex 32`) in staging/prod, and never commit the real one.
ADMIN_AUTH_SECRET=dev-only-admin-jwt-secret-change-me

# --- Customer auth (Story 12.3, AD-26/AD-28) ---
# Secret that signs the storefront customer session cookie `cc_session`.
# REQUIRED and deliberately DIFFERENT from ADMIN_AUTH_SECRET/COOKIE_SECRET
# (strict admin/customer separation, FR-41). Use a long random value
# (`openssl rand -hex 32`) in staging/prod.
CUSTOMER_AUTH_SECRET=dev-only-customer-auth-secret-change-me

# Public base URL of the storefront (Story 12.4). Verification and password
# reset emails link to `${FRONTEND_URL}/verify-email?token=...` and
# `${FRONTEND_URL}/reset-password?token=...`. No trailing path. Falls back to
# http://localhost:3000 when unset (dev only) - SET IT in staging/prod.
FRONTEND_URL=http://localhost:3000

# One initial AdminUser, upserted idempotently by `prisma/seed.ts` (never
# hardcoded in code, per FR-3). ALL THREE are REQUIRED for the seed to
# create/update this row — if any is unset, the seed logs a warning and
# skips admin seeding (the rest of the catalog seed still runs). This is a
# DEVELOPMENT/TESTING convenience only: in staging/production, seed this
# once to bootstrap the very first Admin, then rotate the password through
# a real channel (there is no "forgot password" flow in the MVP) and treat
# these env vars as no longer authoritative — re-running the seed with the
# same values here would otherwise silently reset a since-rotated password
# back to this placeholder.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@212collectorsclub.test
ADMIN_SEED_PASSWORD=change-me-dev-only-admin-password

# Optional (Story 12.4 fix): minimum duration of POST /auth/register in ms,
# so a new and an already-registered email are indistinguishable by timing.
# Default 300 (must stay above the Argon2id cost); tests may set 0.
# REGISTER_MIN_DURATION_MS=300

# TEMPORARY - remove with real SMTP (Story 13.1, FR-53). When exactly `true`,
# enables POST /api/v1/admin/customers/verify-email so an admin can mark a
# customer's email as verified by hand. Unset / false / anything else => the
# route answers 404 as if it did not exist. Keep false unless there is no SMTP.
MANUAL_EMAIL_VERIFY_ENABLED=false

# --- tcgapi.dev (Story 15.3, AD-54) ---
# Leave TCGAPI_KEY blank for local dev/CI: the app uses an in-memory
# FakeTcgApiClient (provider FAKE, no network). Setting it activates the real
# client (sent only in the X-API-Key header, never logged). Free plan = 100
# requests/day (reset 00:00 UTC).
TCGAPI_KEY=

# --- tcgapi.dev ingestion (Story 15.4, AD-55) — `pnpm build && pnpm tcg:ingest` ---
# Comma-separated games (default pokemon) and optional sets (ids or slugs).
# Without TCG_INGEST_SETS only the TCG_INGEST_DEFAULT_SET_LIMIT (5) most
# recent sets per game are ingested: the Free plan (100 req/day) cannot cover
# a whole game. The run saves a per-set cursor and resumes on the next run.
# TCG_INGEST_GAMES=pokemon
# TCG_INGEST_SETS=
# TCG_INGEST_DEFAULT_SET_LIMIT=5
# Per-run request budget, and the quota reserve left for admin/nightly: the
# run stops when the API reports remaining <= TCG_REQUEST_RESERVE.
# TCG_MAX_REQUESTS_PER_RUN=60
# TCG_REQUEST_RESERVE=20

# --- tcgapi.dev nightly price sync (Story 15.7, AD-58) ---
# Cron 03:00 UTC, OFF by default: leaving it false freezes prices of linked
# products. Own request budget per night (shares TCG_REQUEST_RESERVE). Price
# variations above TCG_PRICE_ALERT_PCT percent are logged and audited.
# TCG_NIGHTLY_SYNC_ENABLED=false
# TCG_NIGHTLY_MAX_REQUESTS=50
# TCG_PRICE_ALERT_PCT=25

# --- Master card image download (Story 15.6, AD-57) ---
# Comma-separated hosts the backend may download master card images from when
# creating a Product from a master card (https, port 443 only; redirects must
# stay inside this list). Default shown. Images are stored in uploads/.
# TCG_IMAGE_ALLOWED_HOSTS=product-images.tcgplayer.com,tcgplayer-cdn.tcgplayer.com

# --- Landing CMS images (Story 16.2, AD-64) ---
# Max size in bytes of an image uploaded via POST /admin/landing-content/images
# (default 2097152 = 2 MB). Files go to uploads/public/landing/.
# LANDING_IMAGE_MAX_BYTES=2097152

# --- Pack simulator (Story 16.4, AD-67/AD-69) ---
# Max POST /simulator/packs requests per IP per minute (default 30).
# SIMULATOR_RATE_LIMIT_PER_MIN=30

# Story 17.4 (AD-74): when exactly "true", POST /checkout rejects the legacy flat address format (400 SHIPPING_REQUIRED). Read per request; default false.
CHECKOUT_REQUIRE_SHIPPING=false
