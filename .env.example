# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored — never commit real secrets.

# --- App ---
# Runtime environment: development | staging | production
NODE_ENV=development
# HTTP port the NestJS app listens on
PORT=3000
# Secret used to SIGN the HttpOnly `cartId` cookie (Story 3.1, AD-5) via
# cookie-parser + Express's native `res.cookie(..., { signed: true })`.
# A tampered/forged cartId cookie fails signature verification and is
# treated as if no cart cookie were sent at all — never trusted.
# Placeholder below is dev-only; use a long random value in staging/prod.
COOKIE_SECRET=dev-only-cart-cookie-secret-change-me

# --- Database (PostgreSQL via Prisma) ---
# Must match the docker-compose.yml service for local dev:
#   host: localhost, port: 5433 (mapped from container's 5432),
#   db: collectorsclub_dev, user: collectorsclub
# Password below is a placeholder — replace with a real value locally,
# and keep it in sync with POSTGRES_PASSWORD if you override that too.
DATABASE_URL="postgresql://collectorsclub:collectorsclub_dev_password@localhost:5433/collectorsclub_dev?schema=public"

# --- Database roles (Story 20.1, A90) ---
# The app should connect with the least-privilege role `collectorsclub_<env>_app`
# (no DDL, no UPDATE/DELETE/TRUNCATE on Audit_Events) and migrations should run
# as the database OWNER. Leave MIGRATE_DATABASE_URL unset to keep one role (the
# dev default). With it set: DATABASE_URL = the app role, MIGRATE_DATABASE_URL =
# the owner (used by `prisma migrate deploy`, deploy/deploy.sh and `pnpm db:roles`).
# Create the role with `DB_ROLES_ENV=<env> APP_DB_PASSWORD=... pnpm db:roles`
# (docs/deployment.md 13). Placeholders below are NOT real credentials.
# MIGRATE_DATABASE_URL="postgresql://collectorsclub:<owner-password>@localhost:5433/collectorsclub_dev?schema=public"
# DATABASE_URL="postgresql://collectorsclub_dev_app:<app-password>@localhost:5433/collectorsclub_dev?schema=public"

# --- Audit log verification (Story 20.1, AD-99) ---
# Weekly verification of the audit hash chain (cron, UTC). The expression is read
# from the PROCESS environment when the class is loaded, BEFORE this file is read:
# a value written only here is IGNORED in dev (the default `0 5 * * 0` runs). Export
# it in the shell / systemd EnvironmentFile to change it.
# AUDIT_VERIFY_CRON="0 5 * * 0"
# `full` (default) re-hashes the whole chain each run; `incremental` only the rows
# after the last OK verification (use it only when the chain has millions of rows).
# AUDIT_VERIFY_CRON_MODE=full
# AUDIT_VERIFY_ENABLED=true  # default true, false under NODE_ENV=test
# Optional: the chain head (seq + hash) is mailed here after each weekly run (external
# anchor, A100). Keep those messages OUTSIDE the database and the server.
# AUDIT_ANCHOR_EMAIL=
# Without it production logs a WARN at boot and GET /admin/audit/head and
# /verifications answer `anchorEmailConfigured: false` (the admin screen shows it).
# Audit payload guard (PII / secrets / floats in before|after|reason): by default
# STRICT (throws, so a test fails) everywhere but NODE_ENV=production, where it is
# LENIENT (masks the value, logs the path, the action goes on). Override:
# AUDIT_PAYLOAD_STRICT=true|false

# --- Docker Compose (local dev Postgres container only) ---
# Optional override for the docker-compose Postgres password.
# Defaults to a dev-only placeholder in docker-compose.yml if unset.
POSTGRES_PASSWORD=collectorsclub_dev_password

# --- Email / SMTP (Story 6.1, MailerService) ---
# NOTE: the real production SMTP provider is PRD Open Question OQ9 — still
# UNRESOLVED, pending confirmation from the client (Nabil) before launch.
# The values below are a LOCAL DEV placeholder only, pointed at a
# disposable MailHog/maildev container (see README/docs for how to run
# one). Swapping to the real provider later is an env-var-only change —
# never a code change — by design (see MailerService's doc comment).
# SMTP server host/port MailerService connects to.
SMTP_HOST=localhost
SMTP_PORT=1025
# "true" only for a provider that requires implicit TLS on connect
# (typically port 465). Leave "false" for MailHog/maildev and most
# STARTTLS-capable providers on 587.
SMTP_SECURE=false
# Optional — leave both blank for an unauthenticated local test server
# (MailHog/maildev). A real provider (OQ9) will require both.
SMTP_USER=
SMTP_PASS=
# The "From" header on outbound mail (contact-inquiry admin notification).
SMTP_FROM="212CollectorsClub <no-reply@212collectorsclub.test>"
# Where the "new contact inquiry" notification email is sent (Story 6.1,
# FR-18). Not necessarily the same address as SMTP_USER.
ADMIN_CONTACT_EMAIL=admin@212collectorsclub.test

# --- Stripe (Story 14.3, AD-45/AD-48) ---
# Leave STRIPE_SECRET_KEY blank for local dev/CI: the app falls back to an
# in-memory FakeStripeClient (no network; webhook signatures are still really
# verified against STRIPE_WEBHOOK_SECRET or a built-in fake secret).
# Setting it activates the real Stripe SDK client AND makes
# STRIPE_WEBHOOK_SECRET mandatory (the app refuses to boot without it).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) from the Stripe dashboard or `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# FRONTEND_URL (below, already documented) is also used for Stripe's
# success_url/cancel_url redirects.

# --- Admin auth (Story 7.1, AD-11) ---
# Story 12.2 (AD-26/AD-32): the Admin session token is a BetterAuth signed
# session token (8h, no sliding refresh). Preferred name: ADMIN_AUTH_SECRET;
# the pre-12.2 name ADMIN_JWT_SECRET is still accepted as a fallback (same
# value works) so old .env/CI keep booting. Set at least one of them.
# Secret used to SIGN and VERIFY the Admin session token.
# Deliberately a DIFFERENT secret than COOKIE_SECRET (unrelated trust
# boundaries: a forged cart cookie only affects an anonymous guest cart,
# a forged Admin JWT would grant Admin-Dashboard access — never share the
# value). Placeholder below is dev-only; use a long random value (e.g.
# `openssl rand -hex 32`) in staging/prod, and never commit the real one.
ADMIN_AUTH_SECRET=dev-only-admin-jwt-secret-change-me

# --- Customer auth (Story 12.3, AD-26/AD-28) ---
# Secret that signs the storefront customer session cookie `cc_session`.
# REQUIRED and deliberately DIFFERENT from ADMIN_AUTH_SECRET/COOKIE_SECRET
# (strict admin/customer separation, FR-41). Use a long random value
# (`openssl rand -hex 32`) in staging/prod.
CUSTOMER_AUTH_SECRET=dev-only-customer-auth-secret-change-me

# Public base URL of the storefront (Story 12.4). Verification and password
# reset emails link to `${FRONTEND_URL}/verify-email?token=...` and
# `${FRONTEND_URL}/reset-password?token=...`. No trailing path. Falls back to
# http://localhost:3000 when unset (dev only) - SET IT in staging/prod.
FRONTEND_URL=http://localhost:3000

# One initial AdminUser, upserted idempotently by `prisma/seed.ts` (never
# hardcoded in code, per FR-3). ALL THREE are REQUIRED for the seed to
# create/update this row — if any is unset, the seed logs a warning and
# skips admin seeding (the rest of the catalog seed still runs). This is a
# DEVELOPMENT/TESTING convenience only: in staging/production, seed this
# once to bootstrap the very first Admin, then rotate the password through
# a real channel (there is no "forgot password" flow in the MVP) and treat
# these env vars as no longer authoritative — re-running the seed with the
# same values here would otherwise silently reset a since-rotated password
# back to this placeholder.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@212collectorsclub.test
ADMIN_SEED_PASSWORD=change-me-dev-only-admin-password

# Optional (Story 12.4 fix): minimum duration of POST /auth/register in ms,
# so a new and an already-registered email are indistinguishable by timing.
# Default 300 (must stay above the Argon2id cost); tests may set 0.
# REGISTER_MIN_DURATION_MS=300

# TEMPORARY - remove with real SMTP (Story 13.1, FR-53). When exactly `true`,
# enables POST /api/v1/admin/customers/verify-email so an admin can mark a
# customer's email as verified by hand. Unset / false / anything else => the
# route answers 404 as if it did not exist. Keep false unless there is no SMTP.
MANUAL_EMAIL_VERIFY_ENABLED=false

# --- tcgapi.dev (Story 15.3, AD-54) ---
# Leave TCGAPI_KEY blank for local dev/CI: the app uses an in-memory
# FakeTcgApiClient (provider FAKE, no network). Setting it activates the real
# client (sent only in the X-API-Key header, never logged). Free plan = 100
# requests/day (reset 00:00 UTC).
TCGAPI_KEY=

# --- tcgapi.dev ingestion (Story 15.4, AD-55) — `pnpm build && pnpm tcg:ingest` ---
# Comma-separated games (default pokemon) and optional sets (ids or slugs).
# Without TCG_INGEST_SETS only the TCG_INGEST_DEFAULT_SET_LIMIT (5) most
# recent sets per game are ingested: the Free plan (100 req/day) cannot cover
# a whole game. The run saves a per-set cursor and resumes on the next run.
# TCG_INGEST_GAMES=pokemon
# TCG_INGEST_SETS=
# TCG_INGEST_DEFAULT_SET_LIMIT=5
# Per-run request budget, and the quota reserve left for admin/nightly: the
# run stops when the API reports remaining <= TCG_REQUEST_RESERVE.
# TCG_MAX_REQUESTS_PER_RUN=60
# TCG_REQUEST_RESERVE=20

# --- tcgapi.dev nightly price sync (Story 15.7, AD-58) ---
# Cron 03:00 UTC, OFF by default: leaving it false freezes prices of linked
# products. Own request budget per night (shares TCG_REQUEST_RESERVE). Price
# variations above TCG_PRICE_ALERT_PCT percent are logged and audited.
# TCG_NIGHTLY_SYNC_ENABLED=false
# TCG_NIGHTLY_MAX_REQUESTS=50
# TCG_PRICE_ALERT_PCT=25

# --- Master card image download (Story 15.6, AD-57) ---
# Comma-separated hosts the backend may download master card images from when
# creating a Product from a master card (https, port 443 only; redirects must
# stay inside this list). Default shown. Images are stored in uploads/.
# TCG_IMAGE_ALLOWED_HOSTS=product-images.tcgplayer.com,tcgplayer-cdn.tcgplayer.com

# --- Landing CMS images (Story 16.2, AD-64) ---
# Max size in bytes of an image uploaded via POST /admin/landing-content/images
# (default 2097152 = 2 MB). Files go to uploads/public/landing/.
# LANDING_IMAGE_MAX_BYTES=2097152

# --- Pack simulator (Story 16.4, AD-67/AD-69) ---
# Max POST /simulator/packs requests per IP per minute (default 30).
# SIMULATOR_RATE_LIMIT_PER_MIN=30

# Story 17.4 (AD-74): when exactly "true", POST /checkout rejects the legacy flat address format (400 SHIPPING_REQUIRED). Read per request; default false. Enable ONLY after the frontend sends the new format (docs/deployment.md section 10.1).
CHECKOUT_REQUIRE_SHIPPING=false

# --- Legal consent (Story 19.4, AD-92, A75) ---
# Read per request. When exactly "true", register / checkout / POST /me/consent answer 503 LEGAL_NOT_PUBLISHED if a
# required document (terminos, privacidad, envios, devoluciones) has no version in force. When not "true" (default) such
# a document is simply NOT required and nothing is recorded for it (a WARN is logged, the Order columns stay NULL):
# fine for dev/test, but in PRODUCTION publish the four documents and set this to "true" BEFORE launch (otherwise sales
# go out with no accepted terms). The age declaration is required in either case.
LEGAL_REQUIRE_PUBLISHED=false
# Test-only: "e2e-" points the consent lookup at the sandbox documents (e2e-terminos, ...). Set by vitest.config.e2e.ts;
# honoured ONLY when NODE_ENV=test; in any other environment (production, staging, development, unset) it is ignored
# and the backend logs a WARN at startup. Never set it in a deployed environment.
# LEGAL_CONSENT_SLUG_PREFIX=e2e-

# --- FX rate provider (Story 18.1, AD-79/AD-80) ---
# Rate source/thresholds live in the DB (Fx_Rate_Settings), not here.
# FX_PROVIDER: "dolarapi" (default, real) or "fake" (deterministic, no network; forced when NODE_ENV=test).
FX_PROVIDER=dolarapi
FX_PROVIDER_BASE_URL=https://ve.dolarapi.com
FX_PROVIDER_TIMEOUT_MS=5000
# Cron expression (default every 30 min). Must be exported to the process environment (systemd EnvironmentFile), it is read at module load.
FX_REFRESH_CRON=*/30 * * * *
# "false" disables cron + bootstrap refresh. Default: true (false under NODE_ENV=test).
FX_REFRESH_ENABLED=true

# --- Vitrina interest signals (Story 18.7, AD-82) ---
# Seconds during which a repeated view of the same product from the same IP is not counted (in-memory, per replica).
# VIEW_DEDUP_WINDOW_SEC=1800
# Per-IP limit for POST /products/:id/view (over the limit it still answers 204 without counting).
# VIEW_RATE_LIMIT_PER_MIN=120
# Secret from which the daily dedupe salt derives (random per process if unset; never persisted).
# VIEW_DEDUP_SECRET=

# --- Vitrina scoring (Story 18.8, AD-84) ---
# Recompute cron (default hourly). Must be exported to the process environment (it is read at module load).
# VITRINA_RECOMPUTE_CRON=0 * * * *
# "false" disables the hourly recompute, the bootstrap recompute and the daily run purge. Default: true (false under NODE_ENV=test).
# VITRINA_CRON_ENABLED=true

# --- ID document (cedula/RIF) encryption and blind index (Story 20.2, AD-95) ---
# REQUIRED in every environment (the app refuses to boot without them, also in
# dev/test). The values below are PLACEHOLDERS, not keys: generate real ones with
#   openssl rand -base64 32
# Never commit real values. Production/staging keys live only in the server .env
# AND in a secrets manager copy kept apart from DB backups (docs/deployment.md, section 14).
# LOSING IDDOC_ENC_KEYS MAKES THE STORED CEDULAS UNRECOVERABLE (tax-invoice obligation).
# Keyring "version:base64-32-bytes", comma separated. Add a new version to rotate; never delete one that still encrypts rows.
IDDOC_ENC_KEYS=1:<generate with: openssl rand -base64 32>
# Version used to ENCRYPT new values (must exist in IDDOC_ENC_KEYS).
IDDOC_ENC_ACTIVE_KEY=1
# HMAC key of the blind index and the audit email hash. Different from every encryption key (>= 32 bytes, base64).
# Does NOT rotate with the encryption keys. If it leaks, treat every cedula as exposed (they can be brute-forced).
IDDOC_BLIND_KEY=<generate with: openssl rand -base64 32>
# RIF check digit (SENIAT, A98): "false" validates only the format. Code default (variable unset): strict.
# The weights are the SENIAT ones, but the case "remainder 1 -> check digit 9" is NOT confirmed against a real RIF.
# Until someone checks one real J/G RIF with remainder 1 (docs/deployment.md section 16.4) keep it at "false": a wrong
# "strict" would reject valid customers' RIFs at checkout; "false" only skips the check digit (format stays enforced).
RIF_CHECKDIGIT_STRICT=false

# --- Buyer fiscal ID in checkout (Story 20.4, FR-127) ---
# Read per request. When exactly "true", POST /checkout answers 400 BUYER_ID_REQUIRED unless the body carries `buyerId`
# (or `buyerSameAsRecipient: true` in the agency/saved-address format). DEFAULT false: the current storefront does not
# send it yet (Story 20.9), so turning it on early makes EVERY checkout fail. Turn it on in the same release as 20.9
# (docs/deployment.md section 16.2). When not "true" a buyerId that IS sent is still validated and stored.
CHECKOUT_REQUIRE_BUYER_ID=false

# --- Reveal of the full cedula by an admin (Story 20.4, FR-126) ---
# Max POST /admin/orders/:id/reveal-id-doc per admin per hour (exact count inside the audit chain lock). Default 30.
ID_DOC_REVEAL_MAX_PER_HOUR=30

# --- Admin login brakes (Story 20.5, R4) ---
# Failed admin logins are counted in memory per IP and per (IP, user name) inside the window; past the limit the
# login answers 429 ADMIN_LOGIN_RATE_LIMITED BEFORE hashing anything. Defaults shown.
ADMIN_LOGIN_MAX_FAILURES_PER_IP=20
ADMIN_LOGIN_MAX_FAILURES_PER_USER=5
ADMIN_LOGIN_WINDOW_MS=900000
# LOGIN_ADMIN_FAILED events written to the (unprunable) audit chain per minute, whole instance; beyond it the event
# is dropped and counted (the 401 is unaffected). And how many such writes may be in flight at once.
AUDIT_LOGIN_FAILED_MAX_PER_MINUTE=20
AUDIT_LOGIN_FAILED_MAX_IN_FLIGHT=4
# What that budget drops is not lost: ONE LOGIN_ADMIN_FAILED_SUMMARY event per window (count, window, hashed identifiers)
# is written to the chain, and what is pending is flushed when the app closes. Window in ms, default 60000.
# AUDIT_LOGIN_SUMMARY_WINDOW_MS=60000

# --- Client IP (Story 20.5 follow-up) ---
# Which peers Express believes when they send X-Forwarded-For. Default `loopback`: Nginx and the Next server are on this
# host, req.ip is the address they appended, and a connection from anywhere else is never believed. A hop count (`1`),
# a CIDR list (`loopback,10.0.0.0/8`) or `false` for another topology. See docs/deployment.md 9.4 and 17.
# TRUST_PROXY=loopback

# --- e2e only (Story 20.5) ---
# `pnpm test:e2e` clones this database into a throw-away one and never touches it. Optional: clone THIS database
# instead (a quiet template, when other sessions keep the real one busy; CREATE DATABASE ... TEMPLATE needs 0 sessions;
# how to make one: docs/deployment.md 17.1).
# E2E_DB_SOURCE=collectorsclub_dev
