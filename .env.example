# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored — never commit real secrets.

# --- App ---
# Runtime environment: development | staging | production
NODE_ENV=development
# HTTP port the NestJS app listens on
PORT=3000
# Secret used to SIGN the HttpOnly `cartId` cookie (Story 3.1, AD-5) via
# cookie-parser + Express's native `res.cookie(..., { signed: true })`.
# A tampered/forged cartId cookie fails signature verification and is
# treated as if no cart cookie were sent at all — never trusted.
# Placeholder below is dev-only; use a long random value in staging/prod.
COOKIE_SECRET=dev-only-cart-cookie-secret-change-me

# --- Database (PostgreSQL via Prisma) ---
# Must match the docker-compose.yml service for local dev:
#   host: localhost, port: 5433 (mapped from container's 5432),
#   db: collectorsclub_dev, user: collectorsclub
# Password below is a placeholder — replace with a real value locally,
# and keep it in sync with POSTGRES_PASSWORD if you override that too.
DATABASE_URL="postgresql://collectorsclub:collectorsclub_dev_password@localhost:5433/collectorsclub_dev?schema=public"

# --- Docker Compose (local dev Postgres container only) ---
# Optional override for the docker-compose Postgres password.
# Defaults to a dev-only placeholder in docker-compose.yml if unset.
POSTGRES_PASSWORD=collectorsclub_dev_password

# --- Email / SMTP (Story 6.1, MailerService) ---
# NOTE: the real production SMTP provider is PRD Open Question OQ9 — still
# UNRESOLVED, pending confirmation from the client (Nabil) before launch.
# The values below are a LOCAL DEV placeholder only, pointed at a
# disposable MailHog/maildev container (see README/docs for how to run
# one). Swapping to the real provider later is an env-var-only change —
# never a code change — by design (see MailerService's doc comment).
# SMTP server host/port MailerService connects to.
SMTP_HOST=localhost
SMTP_PORT=1025
# "true" only for a provider that requires implicit TLS on connect
# (typically port 465). Leave "false" for MailHog/maildev and most
# STARTTLS-capable providers on 587.
SMTP_SECURE=false
# Optional — leave both blank for an unauthenticated local test server
# (MailHog/maildev). A real provider (OQ9) will require both.
SMTP_USER=
SMTP_PASS=
# The "From" header on outbound mail (contact-inquiry admin notification).
SMTP_FROM="212CollectorsClub <no-reply@212collectorsclub.test>"
# Where the "new contact inquiry" notification email is sent (Story 6.1,
# FR-18). Not necessarily the same address as SMTP_USER.
ADMIN_CONTACT_EMAIL=admin@212collectorsclub.test

# --- PayPal (Story 4.3) ---
# Real PayPal Sandbox/production app credentials (Developer Dashboard ->
# Apps & Credentials). Leave BOTH blank for local dev without a PayPal
# account: the app automatically falls back to an in-memory FakePaypalClient
# test double that implements the exact same interface (see
# src/payments-paypal/paypal-client.provider.ts) — checkout/webhook flows
# work end-to-end against real Postgres, just without a real PayPal API
# call. Setting BOTH activates the real @paypal/paypal-server-sdk client,
# no code change required.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | production. Defaults to sandbox if unset. Ignored while the two
# vars above are unset (FakePaypalClient doesn't read this).
PAYPAL_ENVIRONMENT=sandbox
