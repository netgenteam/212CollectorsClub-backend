# Copia a scripts/.env.import (está en .gitignore) y rellena.
API_BASE_URL=https://api.tu-dominio.com/api/v1
ADMIN_USER=
ADMIN_PASSWORD=
TCGAPI_KEY=
TCG_GAME=pokemon
TCG_QUERY=charizard
TCG_TYPE=Cards
LIMIT=10
# CATEGORY_ID=
STOCK=5

# --- ingest-master-cards.mjs (Story 15.9): solo API_BASE_URL/ADMIN_USER/ADMIN_PASSWORD son
# obligatorias; no usa TCGAPI_KEY (la key vive solo en el env del servidor). Opcionales:
# INGEST_GAMES=pokemon
# INGEST_SETS=sv3pt5,151
# INGEST_MAX_REQUESTS=40
# INGEST_POLL_SECONDS=5
