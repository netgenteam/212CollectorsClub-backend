# 212CollectorsClub backend — Nginx template for STAGING, routed by
# subdomain per AD-15 (docs/architecture.md).
#
# Install on the VPS as /etc/nginx/sites-available/staging-api.<DOMAIN>.conf,
# replace every <DOMAIN> below with the real domain, then:
#   sudo ln -s /etc/nginx/sites-available/staging-api.<DOMAIN>.conf \
#              /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# TLS (Story 20.11, security audit high priority 3): this template serves HTTPS on 443 and redirects every plain-HTTP
# request on 80 to it, with HSTS. Nginx will not load the 443 block until the certificate files exist, so the order is:
#   1. Point the DNS A/AAAA record of staging-api.<DOMAIN> at the VPS and open ports 80 and 443 (docs/deployment.md 1.8).
#   2. Get the certificate BEFORE enabling this file (port 80 free, or nginx stopped for a minute):
#        sudo certbot certonly --standalone -d staging-api.<DOMAIN>
#      (or, with nginx already serving another site on 80: `--webroot -w /var/www/certbot`; the 80 block below serves
#      /.well-known/acme-challenge/ from that directory). Renewal is automatic (certbot.timer); make it reload nginx:
#        echo 'renew_hook = systemctl reload nginx' | sudo tee -a /etc/letsencrypt/renewal/staging-api.<DOMAIN>.conf
#   3. Install this file, replace <DOMAIN>, then: sudo nginx -t && sudo systemctl reload nginx
#   4. Check: curl -sI http://staging-api.<DOMAIN>/ (301 to https) and curl -sI https://staging-api.<DOMAIN>/api/v1/health (200 and a
#      Strict-Transport-Security header).
# HSTS here is `max-age=15552000` (180 days) WITHOUT includeSubDomains and WITHOUT preload: both are decisions for the
# whole domain, taken once every subdomain serves HTTPS. The backend (helmet) sends the same header in production; `always`
# makes Nginx add it on error pages too, and the two never conflict (proxy_hide_header drops the upstream copy).
#
# NOT verified against a real domain or real traffic in this sandbox — only
# checked with `nginx -t` inside a throwaway nginx:alpine container (no
# nginx installed on this dev machine). See docs/deployment.md for what
# Angel must still confirm on the real VPS.

# Story 20.4 (FR-124, NFR-20.5): a cedula never travels in a URL (the admin order search is
# `POST /api/v1/admin/orders/search` with the cedula in the BODY), so no access log can hold one.
# This format is kept as defence in depth: it logs the normalized path (`$uri`, no query string)
# instead of the whole request line, so no query string (an old client still sending `?idDoc=`,
# a token in a link...) reaches the access log. `error_log` still prints the full request line on
# upstream failures: that is why the contract, not this format, is what keeps cedulas out of URLs
# (docs/deployment.md 16.6).
log_format cc_staging_noquery '$remote_addr - $remote_user [$time_local] '
                          '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                          '"$http_referer" "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name staging-api.<DOMAIN>;

    # Certbot's webroot challenge (renewals with `--webroot -w /var/www/certbot`); everything else goes to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name staging-api.<DOMAIN>;

    ssl_certificate     /etc/letsencrypt/live/staging-api.<DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging-api.<DOMAIN>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=15552000" always;
    # One copy only: the backend sends its own (helmet); drop it here so the browser never sees two.
    proxy_hide_header Strict-Transport-Security;

    # Matches the staging systemd unit's PORT (see
    # /opt/212cc/staging/shared/.env and
    # deploy/systemd/212cc-backend-staging.service) — the app only ever
    # binds to 127.0.0.1 from Nginx's perspective; the actual process may
    # listen on all interfaces (Node/Express default), so the VPS firewall
    # must also block external access to this port directly (see
    # docs/deployment.md, firewall section).
    set $backend 127.0.0.1:3001;

    # Product images / Proof-of-Payment uploads (Stories 4.2, 8.2) —
    # generous but bounded; adjust once real upload limits are confirmed.
    client_max_body_size 10m;

    location / {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;  # always https here: the 80 block only redirects
        proxy_read_timeout 60s;
    }

    access_log /var/log/nginx/212cc-staging.access.log cc_staging_noquery;
    error_log  /var/log/nginx/212cc-staging.error.log;
}
